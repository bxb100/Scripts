{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "immich-share",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-21",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "none",
		"run_worker_first": ["/index.html"],
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01,
		},
	},
	"preview_urls": false,
	"upload_source_maps": true,
	"placement": {
		"mode": "smart",
	},
	"cache": {
		"enabled": true,
	},
	"vpc_networks": [
		{
			"binding": "NAS",
			"tunnel_id": "f12f3b2a-db4c-4a55-bb05-016135e09a8b",
			"remote": true,
		},
	],
}
